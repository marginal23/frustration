  prompt: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  lines:
  - "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u043E\u0442 \u043C\u0430\u043C\u044B."
  - "\xAB\u0421\u044B\u043D\u043E\u043A, \u044F \u043D\u0430 \u0441\u043C\u0435\u043D\u0435 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430. \u0426\u0432\u0435\u0442\u044B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435, \u0440\u0430\u043D\u0435\u0446 \u043D\u0430 \u0441\u0442\u0443\u043B\u0435.\xBB"
  - "\xAB\u041F\u0430\u043F\u0443 \u043D\u0435 \u0431\u0443\u0434\u0438. \u041A\u043B\u044E\u0447 \u043F\u043E\u0434 \u043A\u043E\u0432\u0440\u0438\u043A\u043E\u043C. \u041B\u044E\u0431\u043B\u044E \u0442\u0435\u0431\u044F.\xBB"
