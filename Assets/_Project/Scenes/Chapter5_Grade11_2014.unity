  endTitle: "\u0413\u043B\u0430\u0432\u0430 5. \u041E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439 \u043A\u043B\u0430\u0441\u0441"
  endSubtitle: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0441\u043B\u0435\u0434\u0443\u0435\u0442"
  nextScene: 
